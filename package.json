{
  "name": "storewright",
  "version": "0.1.0",
  "private": true,
  "description": "Storewright — a digital twin for grocery stores: the 3D store in sync with live operations, replay and forecast, equipment alerts, plus online fulfilment, backroom, replenishment, staffing and per-store local AI.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "StoreX",
    "StoreX-Chain",
    "YH-TwinOps"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/simulator/tsconfig.json --noEmit && tsc -p apps/associate/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit && tsc -p apps/api/tsconfig.json --noEmit && tsc -p e2e/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test",
    "sim": "tsx apps/sim-cli/src/main.ts run",
    "compare": "tsx apps/sim-cli/src/main.ts compare",
    "sensitivity": "tsx apps/sim-cli/src/main.ts sensitivity",
    "ai-report": "tsx apps/sim-cli/src/main.ts ai-report",
    "industry-report": "tsx apps/sim-cli/src/main.ts industry-report",
    "notices": "node scripts/third-party-notices.mjs",
    "llm:eval": "tsx apps/server/src/llmEval.ts",
    "dev": "npm run dev -w @storewright/simulator",
    "web": "npm run dev -w @yh/web",
    "api": "npm run dev -w @yh/api",
    "build:sim": "npm run build -w @storewright/simulator",
    "server": "npm run start -w @storewright/server",
    "associate": "npm run dev -w @storewright/associate",
    "build:associate": "npm run build -w @storewright/associate",
    "build:demo": "npm run build:demo -w @storewright/associate",
    "build:all": "npm run build:sim && npm run build:associate && npm run build:demo",
    "build:site": "npm run build:sim && npm run build:demo && npm run build -w storex && npm run build -w storex-chain && npm run build:demo -w @storewright/yard && node scripts/build-site.mjs",
    "site": "node e2e/static-server.mjs site 4188",
    "pack:libs": "node scripts/pack-libs.mjs",
    "e2e": "playwright test",
    "e2e:browsers": "PW_ALL=1 playwright test",
    "walkthrough": "playwright test -c playwright.walkthrough.config.ts; node scripts/walkthrough-report.mjs",
    "demo:site": "node e2e/static-server.mjs",
    "release:check": "node scripts/release-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.10.2",
    "eslint": "10.14.0",
    "fast-check": "3.23.2",
    "globals": "17.14.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.72.1",
    "vitest": "2.1.8"
  },
  "allowScripts": {
    "esbuild@0.23.1": true,
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true
  }
}
